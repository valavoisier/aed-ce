<section class="parallax event-section" data-stellar-background-ratio="0.5"
    style="background-image:url('{{ asset(image) }}');">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="tagline-message event-title text-center">
                    <h3>{{ title }}</h3>
                    <p>{{ subtitle }}</p>
                    <a href="{{ cta_path is defined ? path(cta_path) : '#' }}" class="btn btn-primary">{{ cta_label
                        }}</a>
                </div>
            </div><!-- end col -->
        </div><!-- end row -->
    </div><!-- end container -->
</section><!-- end section -->