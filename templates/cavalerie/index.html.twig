{% extends 'base.html.twig' %}
{% block title %}Contact - centre équestre Goudelancourt{% endblock %}

{% block content %}
{% include 'partials/headers/header-classic.html.twig' with {
        image: 'images/bai.png',
        title: 'Notre cavalerie',
        breadcrumb: 'cavalerie'
    } 
%}
<section class="section">
            <div class="container">

                <div class="row">
                    <div class="row blog-grid shop-grid">
                        <h3>Nos chevaux</h3>
                        {% for cheval in chevaux %}
                        <div class="col-md-3">
                            <div class="course-box shop-wrapper">
                                <div class="image-wrap entry">
                                    <img src="{{ asset('upload/' ~ cheval.image) }}" alt="{{ cheval.nom }}" class="img-fluid">
                                </div>
                                <!-- end image-wrap -->
                                <div class="course-details shop-box text-center">
                                    <h4>
                                        {{ cheval.nom }}
                                        <small>Cheval</small>
                                    </h4>
                                </div><!-- end details -->
                            </div><!-- end box -->
                        </div><!-- end col -->
                        {% endfor %}                       
                        
                        <h3>Nos poneys</h3>

                        {% for poney in poneys %}
                        <div class="col-md-3">
                            <div class="course-box shop-wrapper">
                                <div class="image-wrap entry">
                                    <img src="{{ asset('upload/' ~ poney.image) }}" alt="{{ poney.nom }}" class="img-fluid">
                                </div>
                                <div class="course-details shop-box text-center">
                                    <h4>
                                        {{ poney.nom }}
                                        <small>{{ poney.categorie }}</small>
                                    </h4>
                                </div>
                            </div>
                        </div>
                        {% endfor %}

                    </div><!-- end row -->

                </div><!-- end container -->
        </section>
        <div class="video-container">
            <video autoplay muted loop playsinline>
                <source src="{{ asset('video/regard-free.mp4') }}" type="video/mp4">
            </video>
        </div>
{% endblock %}
