{% extends 'base.html.twig' %}
{% block title %}Inscription - centre équestre Goudelancourt{% endblock %}

{% block content %}
{% include 'partials/headers/header-classic.html.twig' with {
image: 'images/gris.png',
title: 'Inscription',
breadcrumb: 'inscription'
}
%}
<section class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6 offset-md-3">
                <div class="section-title text-center">
                    <h1>Créer un compte</h1>
                </div>

                {{ form_errors(registrationForm) }}

                {{ form_start(registrationForm, {'attr': {'data-turbo': 'false'}}) }}
                {{ form_row(registrationForm.nom, {
                label: 'Votre nom',
                attr: {
                autocomplete: 'family-name',
                placeholder: 'Votre nom'
                }
                }) }}
                {{ form_row(registrationForm.prenom, {
                label: 'Votre prénom',
                attr: {
                autocomplete: 'given-name',
                placeholder: 'Votre prénom'
                }
                }) }}
                {{ form_row(registrationForm.email, {
                label: 'Adresse email',
                attr: {
                autocomplete: 'email',
                placeholder: 'nom@domaine.fr'
                }
                }) }}
                {{ form_row(registrationForm.plainPassword.first, {
                label: 'Votre mot de passe',
                attr: {
                autocomplete: 'new-password',
                placeholder: 'Minimum 8 caractères'
                }
                }) }}
                {{ form_row(registrationForm.plainPassword.second, {
                label: 'Confirmez le mot de passe',
                attr: {
                autocomplete: 'new-password'
                }
                }) }}
                {{ form_row(registrationForm.agreeTerms) }}
                <button type="submit" class="btn btn-primary">Inscription</button>
                {{ form_end(registrationForm) }}
                <!-- Login link -->
                <div class=" mt-3">
                    <p class="text-muted">Vous avez déjà un compte ?
                        <a href="{{ path('app_login') }}" class="link-contact">Se connecter</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}