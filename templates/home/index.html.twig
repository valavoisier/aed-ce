<section class="section db">
    <div class="container">
        <div class="section-title text-white text-center">
            <h3>Nos moniteurs</h3>
            <p>Découvrez notre équipe de moniteurs qualifiés et passionnés.</p>
        </div><!-- end title -->
        <div class="row text-center">
            {% for m in moniteurs %}
            <div class="col-md-3 col-sm-6">
                <div class="teammembers">
                    <div class="entry">
                        <img src="{{ asset('upload/' ~ m.photo) }}" alt="{{ m.nom }} {{ m.prenom }}" class="img-fluid">

                        <div class="magnifier">
                            <div class="visible-buttons1 teambuttons">
                                <img src="{{ asset('upload/' ~ m.diplome) }}" alt="Diplôme de {{ m.nom }} {{ m.prenom }}" class="img-fluid"><p></p>

                               <!-- <div class="social-links">
                                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                                </div> end social -->
                            </div>
                        </div>
                    </div><!-- end box -->

                    <div class="teamdesc">
                        <h4>{{ m.nom }} {{ m.prenom }}</h4>
                        <p>{{ m.qualification }}</p>
                        <p>{{ m.description }}</p>
                    </div><!-- end teamdesc -->
                </div><!-- end teammembers -->
            </div><!-- end col -->
            {% endfor %}            
        </div><!-- end row -->
    </div><!-- end container -->
</section>

