{% extends 'base.html.twig' %}
{% block title %}Equi-Handi - centre équestre Goudelancourt{% endblock %}

{# Hero parallax plein écran : nav transparente superposée, pas de header-normal #}
{# Twig considère un block vide comme "empty", donc on y met un libellé non vide pour que base.html.twig détecte bien la
surcharge #}
{% block header_variant %}header-transparent{% endblock %}

{% block content %}
{% include 'partials/headers/header-parallax.html.twig' with {
image: 'upload/cour2.jpg',
title: 'Nos Infrastructures',
subtitle: "Un environnement adapté au confort des cavaliers et des chevaux",
cta_label: 'Découvrir',
cta_path: 'app_infrastructures'
}
%}

<section class="section gb nopadtop">
    <div class="container">
        <div class="row event-boxes">
            <div class="col-md-4">
                <div class="box m30">
                    <img src="upload/ecurie.jpg" alt="" class="img-fluid">
                    <div class="event-desc">
                        <small>Confort</small>
                        <h4>Écuries</h4>
                        <p>Boxes extérieurs et barns.</p>
                    </div>
                </div>
            </div><!-- end col -->

            <div class="col-md-4">
                <div class="box m30">
                    <img src="upload/carriere.jpg" alt="" class="img-fluid">
                    <div class="event-desc">
                        <small>Espace</small>
                        <h4>Surfaces d'évolution</h4>
                        <p>Manège, carrière, rond de longe, terrain de cross.</p>
                    </div>
                </div>
            </div><!-- end col -->

            <div class="col-md-4">
                <div class="box m30">
                    <img src="upload/paddock.jpg" alt="" class="img-fluid">
                    <div class="event-desc">
                        <small>Bien-être</small>
                        <h4>Paddocks</h4>
                        <p>Paddocks en herbe ou en sable pour la sortie quotidienne des chevaux et poneys.</p>
                    </div>
                </div><!-- end col -->
            </div><!-- end row -->
        </div><!-- end container -->
</section>

<section class="section logos-section">
    <div class="container">
        <div class="row justify-content-center align-items-center text-center">
            <h3>Nos labels de qualité</h3>
            <div class="col-6 col-md-4">
                <img src="upload/plaquette-efe.png" alt="Logo 1" class="img-fluid logo-item">
            </div>

            <div class="col-6 col-md-4">
                <img src="upload/plaquette-handi.png" alt="Logo 2" class="img-fluid logo-item">
            </div>

            <div class="col-6 col-md-4">
                <img src="upload/Logo_BEA.jpg" alt="Logo 3" class="img-fluid logo-item">
            </div>

        </div>
    </div>
</section>

<div class="video-container">
    <video autoplay muted loop playsinline>
        <source src="video/SpotClarbec_.mp4" type="video/mp4">
    </video>
</div>

</div>
{% endblock %}