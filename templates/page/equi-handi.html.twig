{% extends 'base.html.twig' %}
{% block title %}Equi-Handi - centre équestre Goudelancourt{% endblock %}

{# Hero parallax plein écran : nav transparente superposée, pas de header-normal #}
{# Twig considère un block vide comme "empty", donc on y met un libellé non vide pour que base.html.twig détecte bien la
surcharge #}
{% block header_variant %}header-transparent{% endblock %}

{% block content %}
{% include 'partials/headers/header-parallax.html.twig' with {
image: 'upload/equi-handi4.png',
title: 'Equi - Handi',
subtitle: "L'équitation accessible pour tous !",
cta_label: 'Renseignements',
cta_path: 'app_contact'
}
%}

<section class="section gb nopadtop">
    <div class="container">
        <div class="row event-boxes">
            <div class="col-md-4">
                <div class="box m30">
                    <img src="upload/label-handi.png" alt="" class="img-fluid">
                    <div class="event-desc">
                        <small>FFE</small>
                        <h4>Label Équi Handi club</h4>
                        <p>Notre centre équestre, labellisé Équi Handi, accueille les personnes en situation de
                            handicap et propose une équitation accessible à chacun.</p>
                        <h4>Tarifs</h4>
                        {% for tarif in handi %}
                            <p>
                            {{ tarif.titre }} :
                            {{ tarif.prix|number_format(2, ',', ' ') }} €
                            </p>
                        {% endfor %}
                        <p>Séance collective : sur devis</p>
                    </div>
                </div>
            </div><!-- end col -->

            <div class="col-md-4">
                <div class="box m30">
                    <img src="upload/ffe-equi-handi.jpg" alt="" class="img-fluid">
                    <div class="event-desc">
                        <small>Accompagnement individualisé</small>
                        <h4>Cavalerie adaptée</h4>
                        <p>Des séances adaptées aux aux capacités, besoins et rythme de chaque cavalier
                            (cavalerie adaptée et sécurisante, voltige, travail à pied, Equifeel, matériel et
                            exercices adaptés, accompagnement individualisé).</p>
                    </div>
                </div>
            </div><!-- end col -->

            <div class="col-md-4">
                <div class="box m30">
                    <img src="upload/ffe-equi-handi.jpg" alt="" class="img-fluid">
                    <div class="event-desc">
                        <small>Nos objectifs</small>
                        <h4>Le bien-être au contact du cheval</h4>
                        <p>Nos objectifs: favoriser l'autonomie, la confiance en soi, la motricité, la
                            communication et lasocialisation, tout en privilégiant le plaisir et le bien-être au
                            contact du cheval.</p>
                    </div>
                </div>
            </div><!-- end col -->
        </div><!-- end row -->
    </div><!-- end container -->
</section>

<section class="section db">
    <div class="container">
        <div class="section-title text-white text-center">
            <h3>Nos moniteurs</h3>
            <p>Découvrez notre équipe de moniteurs qualifiés et passionnés.</p>
        </div><!-- end title -->
        <div class="row text-center">
            {% for m in moniteurs %}
            <div class="col-md-3 col-sm-6">
                <div class="teammembers">
                    <div class="entry">
                        <img src="{{ asset('upload/' ~ m.photo) }}" alt="{{ m.nom }} {{ m.prenom }}" class="img-fluid">

                        <div class="magnifier">
                            <div class="visible-buttons1 teambuttons">
                                <img src="{{ asset('upload/' ~ m.diplome) }}" alt="Diplôme de {{ m.nom }} {{ m.prenom }}" class="img-fluid"><p></p>

                               <!-- <div class="social-links">
                                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                                </div> end social -->
                            </div>
                        </div>
                    </div><!-- end box -->

                    <div class="teamdesc">
                        <h4>{{ m.nom }} {{ m.prenom }}</h4>
                        <p>{{ m.qualification }}</p>
                        <p>{{ m.description }}</p>
                    </div><!-- end teamdesc -->
                </div><!-- end teammembers -->
            </div><!-- end col -->
            {% endfor %}            
        </div><!-- end row -->
    </div><!-- end container -->
</section>


<section class="section bgcolor1">
    <div class="container">
        <a href="#">
            <div class="row callout">
                <div class="col-md-4 text-center">
                    <img src="upload/label-equi-handi-blanc.png" style="max-width: 100px;" alt="" class="img-fluid"
                        data-aos="fade-right">
                </div><!-- end col -->

                <div class="col-md-8">
                    <p class="lead">Rejoignez-nous!</p>
                    <p class="text-white">Quels que soient vos besoins, vos projets, nous sommes à votre
                        écoute...</p>
                </div>
            </div><!-- end row -->
        </a>
    </div><!-- end container -->
</section>
