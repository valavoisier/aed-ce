<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="keywords" content="">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>{% block title %}AED centre équestre Goudelancourt{% endblock %}</title>

    {# FAVICONS #}
    <link rel="shortcut icon" href="{{ asset('images/aed-logo.ico') }}" type="image/x-icon">
    <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">

    {# GOOGLE FONTS (maquette V5) #}
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,400i,500,700,900" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Droid+Serif:400,400i,700,700i" rel="stylesheet">

    {% block stylesheets %}
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <!-- Swiper -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    <!-- AOS -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css">
    {% endblock %}

    {# Rendu ici (et non en bas de page) pour que le
    <link> vers app.css généré par
    AssetMapper bloque le rendu au même titre que Bootstrap/FontAwesome ci-dessus,
    et évite le flash du #preloader non stylé. #}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>

<body>

    <!-- LOADER -->
    <div id="preloader">
        <img class="preloader" src="{{ asset('images/loader.gif') }}" alt="loader têtes cavalier cheval">
    </div>
    <!-- END LOADER -->

    <div id="wrapper">

        {# NAVBAR #}
        {# header_variant : 'header-normal' par défaut (nav solide, en flux normal).
        Les pages avec un hero plein écran (vidéo/parallax) le surchargent en vide
        pour garder la nav transparente en superposition. #}
        {% block header_variant %}{% endblock %}
        {% set header_variant = block('header_variant') is not empty ? block('header_variant') : 'header-normal' %}
        {% include 'partials/nav.html.twig' with { header_class: header_variant } %}
        {% block content %}{% endblock %}

        {# FOOTER FIXE — commun à toutes les pages #}
        <footer class="section footer noover">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3 col-md-3">
                        <div class="widget clearfix">
                            <h3 class="widget-title">Centre Équestre</h3>
                            <ul class="list-unstyled">
                                <li><a href="#">Accueil</a></li>
                                <li><a href="#">Activités</a></li>
                                <li><a href="#">Tarifs</a></li>
                                <li><a href="#">Planning cours</a></li>
                                <li><a href="#">Contact</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-3">
                        <div class="widget clearfix">
                            <h3 class="widget-title">Informations</h3>
                            <ul class="list-unstyled">
                                <li><a href="#">Mentions légales</a></li>
                                <li><a href="#">Plan du site</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-3">
                        <div class="widget clearfix">
                            <h3 class="widget-title">Tags</h3>
                            <div class="tags-widget">
                                <ul class="list-inline">
                                    <li class="list-inline-item"><a href="#">cheval</a></li>
                                    <li class="list-inline-item"><a href="#">poney</a></li>
                                    <li class="list-inline-item"><a href="#">handicap</a></li>
                                    <li class="list-inline-item"><a href="#">balade</a></li>
                                    <li class="list-inline-item"><a href="#">CSO</a></li>
                                    <li class="list-inline-item"><a href="#">dressage</a></li>
                                    <li class="list-inline-item"><a href="#">cross</a></li>
                                    <li class="list-inline-item"><a href="#">pony games</a></li>
                                    <li class="list-inline-item"><a href="#">voltige</a></li>
                                    <li class="list-inline-item"><a href="#">équitation</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-3">
                        <div class="widget clearfix">
                            <h3 class="widget-title">Coordonnées</h3>
                            <ul class="list-unstyled">
                                <li>3 Rue de l'Église</li>
                                <li>02820 Goudelancourt-lès-Berrieux</li>
                                <li>Tél : 03 23 22 40 49</li>
                                <li><a href="mailto:coordo.equi@aed-asso.fr">coordo.equi@aed-asso.fr</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </footer>

        <div class="copyrights">
            <div class="container">
                <div class="clearfix">
                    <div class="float-start">
                        <div class="cop-logo">
                            <a href="{{ path('app_home') }}"><img src="{{ asset('images/aed-logo.png') }}"
                                    alt="logo aed"></a>
                        </div>
                    </div>

                    <div class="float-end">
                        <div class="footer-links">
                            <ul class="list-inline">
                                <li class="list-inline-item">© 2026 centre-equestre-goudelancourt.fr</li>
                                <li class="list-inline-item">Réalisation : <a href="https://valerielavoisier.fr"
                                        target="_blank">valerielavoisier.fr</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    {# JS #}

    <!-- data-turbo-eval="false" : ces scripts ne doivent s'exécuter qu'une fois, sinon Turbo les
    ré-évalue à chaque navigation et duplique leurs écouteurs globaux (ex: Bootstrap Dropdown
    bascule 2x au clic et s'annule, menu mobile cassé après un changement de page). -->

    <!-- Bootstrap 5 -->
    <script data-turbo-eval="false"
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Swiper -->
    <script data-turbo-eval="false" src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <!-- AOS -->
    <script data-turbo-eval="false" src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    {% block javascripts %}

    <!-- scripts vanilla JS -->
    <script data-turbo-eval="false" src="{{ asset('js/custom.js') }}"></script>
    <!-- Google Maps API obligatoire AVANT map.js -->
    <script data-turbo-eval="false"
        src="https://maps.googleapis.com/maps/api/js?libraries=places&key=AIzaSyAkADq7R0xf6ami9YirAM1N-yl7hdnYBhM"></script>
    <!-- map.js doit lui se réexécuter à chaque navigation pour réinitialiser #map -->
    <script src="{{ asset('js/map.js') }}"></script>
    {% endblock %}


    <!-- ...existing code... -->
</body>

</html>